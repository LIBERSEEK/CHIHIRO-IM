{
  "name": "chihiro",
  "version": "0.1.0",
  "license": "AGPL-3.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "description": "千寻 Chihiro — QQ IM workbench shell over NapCat + Stapxs + AstrBot",
  "type": "module",
  "scripts": {
    "dev": "node backend/src/gateway/server.mjs",
    "gateway": "node backend/src/gateway/server.mjs",
    "dev:gateway": "node --watch backend/src/gateway/server.mjs",
    "backend:check": "npm --prefix backend run check",
    "backend:test": "npm --prefix backend test",
    "status": "node scripts/status.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "open:im": "node scripts/open.mjs im",
    "open:webui": "node scripts/open.mjs webui",
    "open:astrbot": "node scripts/open.mjs astrbot",
    "compose:up": "docker compose --env-file deploy/.env --file deploy/docker-compose.yml up -d",
    "compose:down": "docker compose --env-file deploy/.env --file deploy/docker-compose.yml down",
    "compose:logs": "docker compose --env-file deploy/.env --file deploy/docker-compose.yml logs -f",
    "upstream:status": "node scripts/upstream-status.mjs",
    "build:stapxs": "node scripts/build-stapxs-plugin.mjs",
    "install:stapxs": "node scripts/install-stapxs-plugin.mjs",
    "rebuild:im": "npm run build:stapxs && npm run install:stapxs",
    "rebuild:astrbot-ui": "node scripts/build-astrbot-dashboard.mjs",
    "mcp": "node backend/src/mcp/server.mjs",
    "build:web": "npm --prefix frontend run build",
    "typecheck:web": "npm --prefix frontend run typecheck",
    "test:web": "npm --prefix frontend run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "http-proxy": "^1.18.1",
    "ws": "^8.21.3"
  }
}
